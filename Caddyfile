{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * build/web
	encode gzip

	@nocache {
		path /index.html /flutter_service_worker.js /flutter_bootstrap.js /version.json
	}
	header @nocache Cache-Control "no-cache, no-store, must-revalidate"

	file_server
	try_files {path} /index.html
}
